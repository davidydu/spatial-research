      "containerId": null,
      "originalText": "if isinstance(prepared, Error):\n    raise RuntimeError(prepared.diagnostics)\nrun = simulate(prepared.value,\n    environment=Environment.closed_memory(),\n    budget=Budget(steps=100_000, numeric_work=100_000,\n                  trace_bytes=1_048_576))\nif run.outcome == \"Completed\":\n    got = run.complete_outputs[\"dst\"].to_ints()",
      "autoResize": false,
      "lineHeight": 1.25,
      "type": "text",
      "id": "runtime_result_code_text",
      "x": 2370,
      "y": 1100,
      "width": 1010,
      "height": 200,
      "text": "if isinstance(prepared, Error):\n    raise RuntimeError(prepared.diagnostics)\nrun = simulate(prepared.value,\n    environment=Environment.closed_memory(),\n    budget=Budget(steps=100_000, numeric_work=100_000,\n                  trace_bytes=1_048_576))\nif run.outcome == \"Completed\":\n    got = run.complete_outputs[\"dst\"].to_ints()"
    },
